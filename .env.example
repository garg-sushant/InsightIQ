# ---------------------------------------------------------------------------
# InsightIQ — environment template
#
# Copy to `.env` at the repo root:  cp .env.example .env
# `docker compose up` reads this file. Every value below has a working default
# for local development; NOTHING here requires an external account.
#
# See SETUP_REQUIRED.md for the (short) list of things that need a real account.
# ---------------------------------------------------------------------------

# --- Database (Postgres runs in Docker locally; no account needed) ----------
POSTGRES_USER=insightiq
POSTGRES_PASSWORD=insightiq_dev_password
POSTGRES_DB=insightiq
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Host-side port the db container's 5432 is published on. Defaults to 5433 to
# avoid colliding with a native Postgres install already using 5432 on your
# machine. Only relevant when connecting from the host (e.g. running the
# backend natively instead of via `docker compose up`, or running `alembic`
# from your own shell) — container-to-container traffic inside Compose always
# uses the internal port 5432 regardless of this value.
POSTGRES_HOST_PORT=5433
# Full async SQLAlchemy URL. Overrides the discrete POSTGRES_* vars when set.
# Local docker (backend container -> db container): postgresql+asyncpg://insightiq:insightiq_dev_password@db:5432/insightiq
# Local host (backend run natively):                postgresql+asyncpg://insightiq:insightiq_dev_password@localhost:5433/insightiq
# Neon (prod):                                       postgresql+asyncpg://USER:PASSWORD@ep-xxx.region.aws.neon.tech/insightiq?ssl=require
DATABASE_URL=postgresql+asyncpg://insightiq:insightiq_dev_password@db:5432/insightiq

# --- Security ---------------------------------------------------------------
# REQUIRED IN PRODUCTION. Generate with: openssl rand -hex 32
# The default below is a well-known dev value and is rejected when ENVIRONMENT=production.
SECRET_KEY=dev-insecure-secret-key-change-me-0000000000000000000000000000
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
ALGORITHM=HS256

# --- App --------------------------------------------------------------------
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO
LOG_JSON=false                   # true -> structured JSON logs (use in prod)
API_V1_PREFIX=/api/v1
# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Uploads / ingestion ----------------------------------------------------
MAX_UPLOAD_MB=25
MAX_UPLOAD_ROWS=500000

# --- AI provider ------------------------------------------------------------
# "auto"  -> GrokProvider when GROK_API_KEY is set, otherwise MockProvider.
# "grok"  -> force Grok (fails closed to a degraded response if key missing).
# "mock"  -> force the offline mock provider. All tests use this.
AI_PROVIDER=auto
# Get a key at https://console.x.ai (paid, pay-as-you-go). Optional —
# without it the app runs fully on MockProvider. See SETUP_REQUIRED.md.
GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-4
GROK_TIMEOUT_SECONDS=60
GROK_MAX_TOKENS=2000
AI_CACHE_TTL_SECONDS=3600

# --- Frontend ---------------------------------------------------------------
# Read by Next.js at build + runtime. Points the browser at the FastAPI backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
